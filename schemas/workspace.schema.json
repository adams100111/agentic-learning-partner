{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-learning-partner.dev/schemas/workspace.schema.json",
  "title": "ALP Learner Workspace",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceId",
    "learnerId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{32}$"
    },
    "learnerId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

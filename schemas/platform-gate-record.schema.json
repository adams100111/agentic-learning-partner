{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-learning-partner.dev/schemas/platform-gate-record.schema.json",
  "title": "ALP Platform Gate Record v1",
  "description": "Canonical, append-only record (`authoring-plans/<plan id>/gate-results/<id>.json`) of one Platform Gate Result attached to an Authoring Plan by `alp platform gates record`, with each unit's realization outcome. The result is stored verbatim; ALP never interprets platform-native gate content.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "learnerId",
    "target",
    "plan",
    "recordedAt",
    "result",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^pgr_[0-9a-f]{24}$"
    },
    "learnerId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "intent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^apl_[0-9a-f]{24}$"
        },
        "intent": {
          "enum": [
            "target-skeleton",
            "curriculum",
            "unit",
            "activity",
            "patch"
          ]
        }
      },
      "additionalProperties": false
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "result": {
      "$ref": "platform-gate-result.schema.json"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit",
          "status",
          "reasons"
        ],
        "properties": {
          "unit": {
            "$ref": "#/$defs/specRef"
          },
          "status": {
            "enum": [
              "realized",
              "unrealized"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "not-publishable",
                    "realization-not-reported",
                    "provenance-missing"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "competency": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "realization": {
            "type": "string",
            "pattern": "^rlz_[0-9a-f]{24}$"
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "status": {
              "const": "realized"
            }
          }
        },
        "then": {
          "required": [
            "realization"
          ],
          "properties": {
            "reasons": {
              "maxItems": 0
            }
          }
        },
        "else": {
          "not": {
            "required": [
              "realization"
            ]
          },
          "properties": {
            "reasons": {
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "required": [
        "platform",
        "target"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "specRef": {
      "type": "object",
      "required": [
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^uspec_[0-9a-f]{24}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    }
  }
}

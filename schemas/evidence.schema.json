{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-learning-partner.dev/schemas/evidence.schema.json",
  "title": "ALP Evidence Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "recordedAt",
    "domain",
    "competencies",
    "type",
    "source",
    "observation",
    "strength"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ev_[A-Za-z0-9_-]+$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "type": {
      "enum": [
        "self-report",
        "recognition",
        "explanation",
        "code-reading",
        "code-writing",
        "debugging",
        "project-implementation",
        "code-review",
        "production-incident",
        "platform-event",
        "quiz",
        "exercise",
        "reflection"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "conversation",
            "repository",
            "platform",
            "diagnostic",
            "manual",
            "import"
          ]
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "contentId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "neutral",
        "contradictory"
      ]
    },
    "strength": {
      "enum": [
        "weak",
        "moderate",
        "strong",
        "production"
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "failureClassification": {
      "enum": [
        "syntax-miss",
        "conceptual-miss",
        "implementation-miss",
        "tooling-ecosystem-miss",
        "careless-transient",
        "ambiguous-task",
        "environment-infrastructure"
      ]
    }
  },
  "additionalProperties": false
}
